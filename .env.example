# ===== Aplikasi =====
# Alamat utama webapp (tanpa garis miring di akhir)
APP_URL=https://ftiuby.cloud
# Situs pengguna akan tayang di <nama>.SITES_DOMAIN
SITES_DOMAIN=ftiuby.cloud
# String acak minimal 32 karakter. Buat dengan: openssl rand -hex 32
SESSION_SECRET=

# ===== Database (Postgres dari Dokploy) =====
# Pakai "Internal Connection URL" dari service Postgres di Dokploy
DATABASE_URL=postgres://ftiuby:password@ftiuby-db:5432/ftiuby

# ===== GitHub OAuth App =====
# github.com/settings/developers → OAuth Apps → New
# Callback URL: https://ftiuby.cloud/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Opsional tapi disarankan: fine-grained token TANPA permission apa pun,
# hanya untuk menaikkan limit GitHub API dari 60 ke 5000 request/jam.
GITHUB_TOKEN=

# ===== Dokploy =====
# URL dashboard Dokploy (publik), contoh https://panel.ftiuby.cloud
DOKPLOY_URL=
# Dokploy → Settings → Profile → API/CLI → Generate
DOKPLOY_API_KEY=
# ID environment tempat situs pengguna dibuat. Cari lewat halaman Admin → Koneksi Dokploy
DOKPLOY_ENVIRONMENT_ID=
# Opsional: kalau situs pengguna mau di-build di server remote Dokploy
DOKPLOY_SERVER_ID=

# ===== Aturan platform =====
# Login GitHub yang otomatis jadi admin (pisahkan dengan koma)
ADMIN_GITHUB_LOGINS=
# Jumlah slot beta (akun developer aktif)
BETA_SLOTS=25
# Subdomain tambahan yang tidak boleh dipakai pengguna (pisahkan dengan koma)
RESERVED_SLUGS=
# Opsional: batas resource tiap situs pengguna
# Memori dalam byte (134217728 = 128 MB), CPU dalam nano-CPU (250000000 = 0.25 CPU)
SITE_MEMORY_LIMIT=134217728
SITE_CPU_LIMIT=250000000
